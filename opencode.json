{
  "$schema": "https://opencode.ai/config.json",
  "model": "openai/gpt-6.1-sol",
  "default_agent": "pauprog",
  "snapshots": false,
  "tool_output": {"max_lines": 300, "max_bytes": 30000},
  "watcher": {
    "ignore": [
      "**/node_modules/**",
      "**/vendor/**",
      "**/dist/**",
      "**/build/**",
      "**/.next/**",
      "**/coverage/**",
      "**/.git/**",
      "**/*lock*"
    ]
  },
  "permissions": [
    {"action": "shell", "resource": "*", "effect": "ask"},
    {"action": "edit", "resource": "*", "effect": "ask"},
    {"action": "external_directory", "resource": "*", "effect": "ask"},
    {"action": "shell", "resource": "git *", "effect": "deny"},
    {"action": "shell", "resource": "git.exe *", "effect": "deny"},
    {"action": "shell", "resource": "gh", "effect": "deny"},
    {"action": "shell", "resource": "gh *", "effect": "deny"},
    {"action": "shell", "resource": "gh.exe *", "effect": "deny"},
    {"action": "shell", "resource": "git status", "effect": "allow"},
    {"action": "shell", "resource": "git status *", "effect": "allow"},
    {"action": "shell", "resource": "git diff", "effect": "allow"},
    {"action": "shell", "resource": "git diff *", "effect": "allow"},
    {"action": "shell", "resource": "git log", "effect": "allow"},
    {"action": "shell", "resource": "git log *", "effect": "allow"},
    {"action": "shell", "resource": "git show", "effect": "allow"},
    {"action": "shell", "resource": "git show *", "effect": "allow"},
    {"action": "shell", "resource": "git blame", "effect": "allow"},
    {"action": "shell", "resource": "git blame *", "effect": "allow"},
    {"action": "shell", "resource": "git ls-files", "effect": "allow"},
    {"action": "shell", "resource": "git ls-files *", "effect": "allow"},
    {"action": "shell", "resource": "git rev-parse", "effect": "allow"},
    {"action": "shell", "resource": "git rev-parse *", "effect": "allow"},
    {"action": "shell", "resource": "git branch", "effect": "allow"},
    {"action": "shell", "resource": "git branch --show-current", "effect": "allow"},
    {"action": "shell", "resource": "git branch -a", "effect": "allow"},
    {"action": "shell", "resource": "git branch -r", "effect": "allow"},
    {"action": "shell", "resource": "git branch -vv", "effect": "allow"},
    {"action": "shell", "resource": "git branch --list *", "effect": "allow"},
    {"action": "shell", "resource": "git remote -v", "effect": "allow"},
    {"action": "shell", "resource": "git pull", "effect": "ask"},
    {"action": "shell", "resource": "git pull *", "effect": "ask"},
    {"action": "shell", "resource": "*git add*", "effect": "deny"},
    {"action": "shell", "resource": "*git commit*", "effect": "deny"},
    {"action": "shell", "resource": "*git push*", "effect": "deny"},
    {"action": "shell", "resource": "*git merge*", "effect": "deny"},
    {"action": "shell", "resource": "*git rebase*", "effect": "deny"},
    {"action": "shell", "resource": "*git reset*", "effect": "deny"},
    {"action": "shell", "resource": "*git checkout*", "effect": "deny"},
    {"action": "shell", "resource": "*git switch*", "effect": "deny"},
    {"action": "shell", "resource": "*git restore*", "effect": "deny"},
    {"action": "shell", "resource": "*git stash*", "effect": "deny"},
    {"action": "shell", "resource": "*git cherry-pick*", "effect": "deny"},
    {"action": "shell", "resource": "*git revert*", "effect": "deny"},
    {"action": "shell", "resource": "*git tag*", "effect": "deny"},
    {"action": "shell", "resource": "*git clean*", "effect": "deny"},
    {"action": "shell", "resource": "*git rm*", "effect": "deny"},
    {"action": "shell", "resource": "*git mv*", "effect": "deny"},
    {"action": "shell", "resource": "*git config*", "effect": "deny"},
    {"action": "shell", "resource": "*git worktree*", "effect": "deny"},
    {"action": "shell", "resource": "*git apply*", "effect": "deny"},
    {"action": "shell", "resource": "*git am*", "effect": "deny"},
    {"action": "shell", "resource": "*git init*", "effect": "deny"},
    {"action": "shell", "resource": "*git clone*", "effect": "deny"},
    {"action": "shell", "resource": "*git submodule*", "effect": "deny"},
    {"action": "shell", "resource": "*git gc*", "effect": "deny"},
    {"action": "shell", "resource": "*git update-ref*", "effect": "deny"},
    {"action": "shell", "resource": "*git branch -d*", "effect": "deny"},
    {"action": "shell", "resource": "*git branch -D*", "effect": "deny"},
    {"action": "shell", "resource": "*git branch -m*", "effect": "deny"},
    {"action": "shell", "resource": "*git branch -M*", "effect": "deny"},
    {"action": "shell", "resource": "*git*--output*", "effect": "deny"},
    {"action": "shell", "resource": "* gh *", "effect": "deny"},
    {"action": "shell", "resource": "* gh.exe *", "effect": "deny"}
  ],
  "policies": [
    {"action": "tool.use", "resource": "shell:*git add*", "effect": "deny"},
    {"action": "tool.use", "resource": "shell:*git commit*", "effect": "deny"},
    {"action": "tool.use", "resource": "shell:*git push*", "effect": "deny"},
    {"action": "tool.use", "resource": "shell:*git merge*", "effect": "deny"},
    {"action": "tool.use", "resource": "shell:*git rebase*", "effect": "deny"},
    {"action": "tool.use", "resource": "shell:*git reset*", "effect": "deny"},
    {"action": "tool.use", "resource": "shell:*git checkout*", "effect": "deny"},
    {"action": "tool.use", "resource": "shell:*git switch*", "effect": "deny"},
    {"action": "tool.use", "resource": "shell:*git restore*", "effect": "deny"},
    {"action": "tool.use", "resource": "shell:*git stash*", "effect": "deny"},
    {"action": "tool.use", "resource": "shell:*git cherry-pick*", "effect": "deny"},
    {"action": "tool.use", "resource": "shell:*git revert*", "effect": "deny"},
    {"action": "tool.use", "resource": "shell:*git tag*", "effect": "deny"},
    {"action": "tool.use", "resource": "shell:*git clean*", "effect": "deny"},
    {"action": "tool.use", "resource": "shell:*git rm*", "effect": "deny"},
    {"action": "tool.use", "resource": "shell:*git mv*", "effect": "deny"},
    {"action": "tool.use", "resource": "shell:*git config*", "effect": "deny"},
    {"action": "tool.use", "resource": "shell:*git worktree*", "effect": "deny"},
    {"action": "tool.use", "resource": "shell:*git apply*", "effect": "deny"},
    {"action": "tool.use", "resource": "shell:*git am*", "effect": "deny"},
    {"action": "tool.use", "resource": "shell:*git init*", "effect": "deny"},
    {"action": "tool.use", "resource": "shell:*git clone*", "effect": "deny"},
    {"action": "tool.use", "resource": "shell:*git submodule*", "effect": "deny"},
    {"action": "tool.use", "resource": "shell:*git gc*", "effect": "deny"},
    {"action": "tool.use", "resource": "shell:*git update-ref*", "effect": "deny"},
    {"action": "tool.use", "resource": "shell:gh *", "effect": "deny"},
    {"action": "tool.use", "resource": "shell:gh.exe *", "effect": "deny"},
    {"action": "tool.use", "resource": "shell:* gh *", "effect": "deny"},
    {"action": "tool.use", "resource": "opencode_worktree_*:*", "effect": "deny"}
  ]
}